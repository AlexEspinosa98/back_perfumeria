# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS: URL(s) del front separadas por coma
CORS_ORIGINS=http://localhost:3000

# URL pública del front (para enlaces en correos)
FRONTEND_URL=http://localhost:3000

# Correo (Resend). Sin RESEND_API_KEY los correos se registran en log y NO se envían.
RESEND_API_KEY=
EMAIL_FROM=Perfumería <onboarding@resend.dev>

# Firma de enlaces de baja (cualquier string largo y aleatorio)
UNSUBSCRIBE_SECRET=change-me

# Código de país por defecto para teléfonos sin prefijo
DEFAULT_COUNTRY_CODE=57
